# Copy to .env and adjust. The API reads these.

# Postgres connection (Supabase gives you this string in production).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/configurator?schema=public"

# API server
PORT=4000
# Public base URL the API uses when building stored-file URLs.
# In dev the web app proxies /uploads to the API, so a relative base is fine.
PUBLIC_BASE_URL=""

# Where generated renders are written when using local storage.
STORAGE_DIR="./uploads"

# Render provider: "mock" (no API key, generates placeholder layers)
# Later: "replicate" or "stability" once you add those implementations + keys.
RENDER_PROVIDER="mock"

# Provider keys (unused by the mock provider; here for when you swap providers).
# REPLICATE_API_TOKEN=""
# STABILITY_API_KEY=""
